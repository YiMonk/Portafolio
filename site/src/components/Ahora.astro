---
import ahoraData from '../../content/sections/09-ahora.json';

const { section_number, section_label, title, intro, updated, location, states } = ahoraData;
---

<section id="section-09" data-section-number="09" class="ahora">
  <div class="ahora__content">
    <p class="ahora__section-label">§ {section_number} · {section_label}</p>

    <h2 class="ahora__title">
      <span class="ahora__title-line">{title.line_1}</span>
      <span class="ahora__title-line">
        {(() => {
          const [before, after] = title.line_2.split(title.highlight);
          return <>
            {before}
            <span class="ahora__highlight">{title.highlight}</span>
            {after}
          </>;
        })()}
      </span>
    </h2>

    <div class="ahora__intro">
      <p class="ahora__intro-text">
        Una página corta sobre lo que <em class="ahora__intro-em">{intro.highlight}</em> estoy haciendo ahora mismo.
      </p>
      <p class="ahora__meta">ACTUALIZADO {updated}</p>
      <p class="ahora__meta">{location}</p>
    </div>

    <div class="ahora__states">
      {states.map((state) => (
        <div class="ahora__state">
          <span class="ahora__state-label">{state.label}</span>
          <p class="ahora__state-text">{state.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ahora {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    padding: var(--space-8);
    padding-top: var(--space-8);
    background-color: var(--color-cream);
  }

  .ahora__content {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
  }

  .ahora__section-label {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gray-60);
    margin: 0;
    text-align: center;
  }

  .ahora__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 6rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--color-black);
    text-wrap: balance;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.2em;
  }

  .ahora__title-line {
    display: block;
  }

  .ahora__highlight {
    color: var(--color-blue);
  }

  .ahora__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-top: 1px solid var(--color-gray-10);
    padding-top: var(--space-4);
  }

  .ahora__intro-text {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-gray-75);
    line-height: 1.6;
    margin: 0;
  }

  .ahora__intro-em {
    font-style: italic;
    color: var(--color-black);
  }

  .ahora__meta {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gray-60);
    margin: 0;
  }

  .ahora__states {
    display: flex;
    flex-direction: column;
  }

  .ahora__state {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-4);
    border-top: 1px solid var(--color-gray-10);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    align-items: start;
  }

  .ahora__state-label {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-black);
    font-weight: 700;
    padding-top: 0.1em;
  }

  .ahora__state-text {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-gray-75);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1199px) {
    .ahora {
      grid-template-columns: 1fr;
    }
    .ahora__content {
      grid-column: 1;
      max-width: 720px;
    }
  }

  @media (max-width: 767px) {
    .ahora {
      padding: var(--space-4);
      padding-top: var(--space-4);
    }

    .ahora__state {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
