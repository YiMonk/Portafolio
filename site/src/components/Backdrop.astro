---
/**
 * Backdrop: a fixed "dim planet" landscape behind all sections.
 * Ridgelines are generated at build time with a seeded midpoint-displacement
 * function (deterministic, no Math.random). Each profile is tileable: the
 * first and last heights are equal, and two copies sit side by side so a
 * translateX(-50%) loop is seamless. Lit faces: a copy of each silhouette
 * shifted toward the sun (left) peeks out above the real one on slopes facing it.
 */
function mulberry32(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const PERIOD_W = 1200;
const VIEW_W = PERIOD_W * 2;
const VIEW_H = 600;
const STEPS = 64; // segments per period -> 65 + 64 points once duplicated

function profile(seed: number, roughness: number): number[] {
  const rand = mulberry32(seed);
  const h = new Array<number>(STEPS + 1).fill(0);
  h[0] = h[STEPS] = 0.5;
  let amp = 0.5;
  for (let step = STEPS; step > 1; step /= 2) {
    const half = step / 2;
    for (let i = half; i < STEPS; i += step) {
      h[i] = (h[i - half] + h[i + half]) / 2 + (rand() * 2 - 1) * amp;
    }
    amp *= roughness;
  }
  const min = Math.min(...h);
  const max = Math.max(...h);
  return h.map((v) => (v - min) / (max - min));
}

interface LayerDef {
  seed: number;
  roughness: number;
  heightVh: number; // box height
  lo: number; // lowest ridge height as a fraction of the box
  hi: number; // highest ridge height as a fraction of the box
  duration: number; // seconds per loop
  rim: boolean;
}

const defs: LayerDef[] = [
  { seed: 1187, roughness: 0.48, heightVh: 36, lo: 0.52, hi: 1.0, duration: 240, rim: true },
  { seed: 4093, roughness: 0.5, heightVh: 30, lo: 0.4, hi: 0.92, duration: 190, rim: true },
  { seed: 7741, roughness: 0.52, heightVh: 24, lo: 0.32, hi: 0.88, duration: 150, rim: false },
  { seed: 9311, roughness: 0.54, heightVh: 17, lo: 0.36, hi: 0.92, duration: 120, rim: false },
];

const layers = defs.map((d, idx) => {
  const p = profile(d.seed, d.roughness);
  const pts: string[] = [];
  const xy: Array<[number, number]> = [];
  for (let c = 0; c < 2; c++) {
    for (let i = c === 0 ? 0 : 1; i <= STEPS; i++) {
      const x = c * PERIOD_W + (i / STEPS) * PERIOD_W;
      const y = VIEW_H - VIEW_H * (d.lo + (d.hi - d.lo) * p[i]);
      pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
      xy.push([x, y]);
    }
  }
  return {
    n: idx + 1,
    heightVh: d.heightVh,
    duration: d.duration,
    rim: d.rim,
    ridge: `M${pts.join('L')}`,
    fill: `M0,${VIEW_H}L${pts.join('L')}L${VIEW_W},${VIEW_H}Z`,
  };
});
---

<div class="backdrop" aria-hidden="true">
  <div class="backdrop__glow"></div>
  <div class="backdrop__sun"></div>
  {layers.map((l) => (
    <>
      <svg
        class={`backdrop__layer backdrop__layer--${l.n}`}
        style={`--bd-h:${l.heightVh}vh;--bd-dur:${l.duration}s`}
        viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
        preserveAspectRatio="none"
        focusable="false"
      >
        <g class="backdrop__lit-face" transform="translate(-22 0)">
          <path class="backdrop__fill" d={l.fill}></path>
          <path class="backdrop__lit" d={l.fill}></path>
        </g>
        <path class="backdrop__fill" d={l.fill}></path>
        <path class="backdrop__rim" d={l.ridge} vector-effect="non-scaling-stroke"></path>
      </svg>
      {l.n <= 3 && <div class={`backdrop__haze backdrop__haze--${l.n}`}></div>}
    </>
  ))}
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: var(--bd-opacity);
  }

  /* Wide faint halo around the star (left of centre, behind the far ridge) */
  .backdrop__glow {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 0;
    height: 62vh;
    background: radial-gradient(ellipse 34% 80% at 32% 100%, var(--bd-glow), transparent 72%);
    animation: backdrop-breathe 14s ease-in-out infinite alternate;
  }

  /* Blue dwarf: small soft-edged disc + corona, partially hidden by layer 1 */
  .backdrop__sun {
    --sun-r: clamp(24px, 2.6vw, 40px);
    position: absolute;
    left: 32%;
    bottom: 26vh;
    width: calc(var(--sun-r) * 2);
    height: calc(var(--sun-r) * 2);
    margin-left: calc(var(--sun-r) * -1);
    margin-bottom: calc(var(--sun-r) * -1);
    border-radius: 50%;
    background: radial-gradient(circle, var(--bd-sun-core) 0 62%, var(--bd-sun-edge) 82%, transparent 100%);
    box-shadow: 0 0 calc(var(--sun-r) * 1.5) calc(var(--sun-r) * 0.4) var(--bd-sun-halo);
    animation: backdrop-breathe 10s ease-in-out infinite alternate;
  }

  .backdrop__layer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 200%;
    max-width: none; /* reset.css caps svg at 100% */
    height: var(--bd-h);
    will-change: transform;
    animation: backdrop-drift var(--bd-dur) linear infinite;
  }

  .backdrop__fill {
    transition: fill 250ms ease;
  }
  .backdrop__layer--1 .backdrop__fill { fill: var(--bd-ridge-1); }
  .backdrop__layer--2 .backdrop__fill { fill: var(--bd-ridge-2); }
  .backdrop__layer--3 .backdrop__fill { fill: var(--bd-ridge-3); }
  .backdrop__layer--4 .backdrop__fill { fill: var(--bd-ridge-4); }

  .backdrop__lit { fill: var(--bd-lit); }
  .backdrop__layer--1 .backdrop__lit { opacity: 0.5; }
  .backdrop__layer--2 .backdrop__lit { opacity: 0.65; }
  .backdrop__layer--3 .backdrop__lit { opacity: 0.8; }

  /* Rim gets crisper toward the viewer */
  .backdrop__rim {
    fill: none;
    stroke: var(--bd-rim);
    stroke-linejoin: round;
  }
  .backdrop__layer--1 .backdrop__rim { stroke-width: 1.5px; opacity: 0.45; }
  .backdrop__layer--2 .backdrop__rim { stroke-width: 1.25px; opacity: 0.55; }
  .backdrop__layer--3 .backdrop__rim { stroke-width: 1px; opacity: 0.75; }
  .backdrop__layer--4 .backdrop__rim { stroke-width: 0.75px; opacity: 1; }

  .backdrop__haze {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to top, var(--bd-haze), transparent);
  }
  /* Fog bands: thicker between far layers */
  .backdrop__haze--1 { height: 34vh; }
  .backdrop__haze--2 { height: 26vh; opacity: 0.8; }
  .backdrop__haze--3 { height: 18vh; opacity: 0.6; }

  @keyframes backdrop-drift {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @keyframes backdrop-breathe {
    from { opacity: 0.85; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .backdrop__layer,
    .backdrop__sun,
    .backdrop__glow {
      animation: none;
    }
  }
</style>
