---
import bifurcacionData from '../../content/sections/02-bifurcacion.json';

const { cards } = bifurcacionData;
---

<section id="section-02" data-section-number="02" class="bifurcacion" data-reveal-group>
  {cards.map((card) => (
    <a class="bif-route" href={card.cta.href} data-reveal>
      <div class="bif-route__left">
        <p class="bif-route__headline">{card.headline}</p>
        <p class="bif-route__description">{card.description}</p>
        <span class="bif-route__cta">{card.cta.text}</span>
      </div>
      <span class="bif-route__number" aria-hidden="true">{card.route_number}</span>
    </a>
  ))}
</section>

<style>
  .bifurcacion {
    height: 100vh;
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--color-black);
    background-color: transparent;
  }

  .bif-route {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-8);
    border-bottom: 1px solid var(--color-gray-10);
    text-decoration: none;
    overflow: hidden;
    position: relative;
    transition: background-color 250ms ease;
  }

  .bif-route:hover {
    background-color: var(--color-black);
  }

  .bif-route:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: -4px;
  }

  /* ── Lado izquierdo: textos ── */
  .bif-route__left {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    z-index: 2;
    max-width: 55%;
  }

  .bif-route__headline {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 2.2rem);
    font-weight: 900;
    color: var(--color-black);
    margin: 0;
    line-height: 1.05;
    transition: color 250ms ease;
  }

  .bif-route:hover .bif-route__headline {
    color: var(--color-cream);
  }

  .bif-route__description {
    font-family: var(--font-body);
    font-size: clamp(0.7rem, 1vw, 0.875rem);
    color: var(--color-gray-60);
    margin: 0;
    line-height: 1.5;
    transition: color 250ms ease;
  }

  .bif-route:hover .bif-route__description {
    color: var(--color-cream-60);
  }

  .bif-route__cta {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-black);
    border-bottom: 1px solid var(--color-blue);
    padding-bottom: 2px;
    display: inline-block;
    transition: color 250ms ease, border-bottom-color 250ms ease;
    margin-top: var(--space-2);
  }

  .bif-route:hover .bif-route__cta {
    color: var(--color-cream);
    border-bottom-color: var(--color-cream);
  }

  /* ── Número de ruta (elemento visual dominante) ── */
  .bif-route__number {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(5rem, 11vw, 13rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-black);
    user-select: none;
    pointer-events: none;
    flex-shrink: 0;
    transition: color 250ms ease, -webkit-text-stroke-color 250ms ease;
  }

  .bif-route:hover .bif-route__number {
    color: var(--color-blue);
    -webkit-text-stroke-color: var(--color-blue);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .bif-route,
    .bif-route__headline,
    .bif-route__description,
    .bif-route__cta,
    .bif-route__number {
      transition: none;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .bifurcacion {
      height: auto;
      min-height: 100vh;
    }

    .bif-route {
      flex: none;
      min-height: 33.333vh;
      padding: var(--space-3) var(--space-4);
    }

    .bif-route__left {
      min-width: 0;
      max-width: 100%;
      flex: 1;
      gap: var(--space-1);
    }

    .bif-route__headline {
      font-size: clamp(1rem, 4.5vw, 1.5rem);
    }

    .bif-route__number {
      font-size: clamp(2.5rem, 13vw, 6rem);
      margin-left: var(--space-2);
    }
  }
</style>
