---
import seccionData from '../../content/sections/08-educacion.json';
import educacionData from '../../content/collections/educacion.json';

const { section_number, section_label, title } = seccionData;
const cursos = educacionData.items
  .filter((c) => c.visible)
  .sort((a, b) => a.order - b.order);
---

<section id="section-08" data-section-number="08" class="educacion">
  <div class="educacion__content">
    <p class="educacion__section-label">§ {section_number} · {section_label}</p>

    <h2 class="educacion__title">
      <span class="educacion__title-line">{title.line_1}</span>
      <span class="educacion__title-line educacion__highlight">{title.line_2}</span>
    </h2>

    <div class="educacion__list" role="list">
      {cursos.map((curso) => (
        <div class="educacion__row" role="listitem">
          <span class="educacion__row-year">{curso.year}</span>
          <div class="educacion__row-info">
            <p class="educacion__row-title">{curso.title}</p>
            {curso.platform && (
              <p class="educacion__row-platform">{curso.platform}</p>
            )}
            <p class="educacion__row-description">{curso.description}</p>
          </div>
          <div class="educacion__row-action">
            {curso.link.url && (
              <a
                class="educacion__row-cert"
                href={curso.link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {curso.link.label}<span class="sr-only"> (abre en nueva pestaña)</span> ↗
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .educacion {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    padding: var(--space-8);
    padding-top: var(--space-8);
    background-color: var(--color-cream);
  }

  .educacion__content {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
  }

  .educacion__section-label {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gray-60);
    margin: 0;
    text-align: center;
  }

  .educacion__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 6rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--color-black);
    text-wrap: balance;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.2em;
  }

  .educacion__title-line {
    display: block;
  }

  .educacion__highlight {
    color: var(--color-blue);
  }

  .educacion__list {
    display: flex;
    flex-direction: column;
  }

  .educacion__row {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: var(--space-4);
    border-top: 1px solid var(--color-gray-10);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    align-items: start;
  }

  .educacion__row-year {
    font-family: var(--font-body);
    font-size: 0.625rem;
    color: var(--color-gray-60);
    letter-spacing: 0.1em;
    padding-top: 0.1em;
  }

  .educacion__row-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .educacion__row-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-black);
    margin: 0;
  }

  .educacion__row-platform {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gray-60);
    margin: 0;
  }

  .educacion__row-description {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-gray-75);
    line-height: 1.6;
    margin: 0;
  }

  .educacion__row-action {
    min-width: 0;
  }

  .educacion__row-cert {
    display: inline-flex;
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-black);
    font-weight: 700;
    text-decoration: none;
    border: 1px solid var(--color-black);
    padding: 0.375rem 0.75rem;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .educacion__row-cert:hover {
    color: var(--color-blue);
    border-color: var(--color-blue);
  }

  .educacion__row-cert:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  @media (max-width: 1199px) {
    .educacion {
      grid-template-columns: 1fr;
    }
    .educacion__content {
      grid-column: 1;
      max-width: 720px;
    }
  }

  @media (max-width: 767px) {
    .educacion {
      padding: var(--space-4);
      padding-top: var(--space-4);
    }

    .educacion__row {
      grid-template-columns: 3rem 1fr;
      grid-template-rows: auto auto;
    }

    .educacion__row-action {
      grid-column: 2;
    }
  }
</style>
