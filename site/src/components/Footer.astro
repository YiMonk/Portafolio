---
import siteData from '../../content/global/site.json';

const emailChannel = siteData.contact_channels.find((c: any) => c.id === 'email');
const githubChannel = siteData.contact_channels.find((c: any) => c.id === 'github');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner" data-reveal>
    <div class="footer__left">
      <p class="footer__name">JESÚS CALLES</p>
      <p class="footer__tagline">Piensas el qué. Resuelvo el cómo.</p>
    </div>
    <div class="footer__right">
      {emailChannel?.value && (
        <a href={`mailto:${emailChannel.value}`} class="footer__link">
          {emailChannel.value}
        </a>
      )}
      {githubChannel?.value && (
        <a
          href={`https://${githubChannel.value}`}
          target="_blank"
          rel="noopener noreferrer"
          class="footer__link"
        >
          {githubChannel.value} ↗
        </a>
      )}
      <p class="footer__copy">© {year} Jesús Calles.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-cream);
    border-top: 1px solid var(--color-black);
    padding: var(--space-4) var(--space-8);
    position: relative;
    z-index: 2;
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 1400px;
    margin: 0 auto;
  }

  .footer__left,
  .footer__right {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer__right {
    align-items: flex-end;
    text-align: right;
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: var(--color-black);
    margin: 0;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: 0.625rem;
    color: var(--color-gray-60);
    margin: 0;
    font-style: italic;
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-black);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: 0.4rem 0;
    display: inline-block;
    min-height: 1.5rem;
  }

  .footer__link:hover {
    color: var(--color-blue);
  }

  .footer__link:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 3px;
  }

  .footer__copy {
    font-family: var(--font-body);
    font-size: 0.625rem;
    color: var(--color-gray-60);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 767px) {
    .footer {
      padding: var(--space-4);
    }

    .footer__inner {
      flex-direction: column;
      gap: var(--space-3);
    }

    .footer__right {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
