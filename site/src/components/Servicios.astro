---
import serviciosSectionData from '../../content/sections/06-servicios.json';
import serviciosData from '../../content/collections/servicios.json';
import characterData from '../../content/global/character.json';

const { section_number, section_label, title } = serviciosSectionData;
const handshakePose = characterData.poses.find((p) => p.section === '06');

function formatPrice(pricing: { type: string; amount: number | null; currency: string | null; label?: string }): string {
  if (pricing.type === 'fixed' && pricing.amount !== null) {
    return `$${pricing.amount} ${pricing.currency ?? 'USD'}`;
  }
  if (pricing.type === 'from' && pricing.amount !== null) {
    return `DESDE $${pricing.amount} ${pricing.currency ?? 'USD'}`;
  }
  return 'A CONSULTAR';
}

const servicios = serviciosData.items
  .filter((s) => s.visible)
  .sort((a, b) => a.order - b.order)
  .map((s) => ({ ...s, priceLabel: formatPrice(s.pricing) }));
---

<section id="section-06" data-section-number="06" class="servicios">
  <!-- Header centrado -->
  <div class="servicios__header" data-reveal-group>
    <p class="servicios__section-label" data-reveal>§ {section_number} · {section_label}</p>
    <h2 class="servicios__title" data-reveal>
      <span class="servicios__title-line">{title.line_1}</span>
      <span class="servicios__title-line">{title.line_2}</span>
    </h2>
  </div>

  <!-- Body: cards izquierda + personaje derecha -->
  <div class="servicios__body">
    <div class="servicios__cards" data-reveal-group>
      {servicios.map((s) => (
        <article class="servicios__card" data-reveal>
          <header class="servicios__card-header">
            <h3 class="servicios__card-name">{s.name}</h3>
            <span class="servicios__card-price">{s.priceLabel}</span>
          </header>
          <p class="servicios__card-for">{s.for_whom}</p>
          <ul class="servicios__card-includes">
            {s.includes.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="servicios__card-deliverables">
            <span class="servicios__deliverables-label">ENTREGABLES</span>
            <p class="servicios__deliverables-text">{s.deliverables}</p>
          </div>
          <a
            class="servicios__card-cta"
            href="#section-10"
            data-prefill-subject={s.cta.prefill_subject}
          >
            {s.cta.text} ↗
          </a>
        </article>
      ))}
    </div>

    {handshakePose?.src_png && (
      <div class="servicios__character portrait" aria-hidden="true" data-reveal>
        <picture>
          {handshakePose.src_mobile_webp && (
            <source srcset={handshakePose.src_mobile_webp} media="(max-width: 767px)" type="image/webp" />
          )}
          {handshakePose.src_webp && <source srcset={handshakePose.src_webp} type="image/webp" />}
          <img src={handshakePose.src_png} width={handshakePose.width} height={handshakePose.height} alt="" loading="lazy" />
        </picture>
      </div>
    )}
  </div>
</section>

<style>
  .servicios {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-8);
    padding-top: var(--space-8);
    background-color: var(--color-cream);
  }

  /* ── Header centrado ── */
  .servicios__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
    text-align: center;
  }

  .servicios__section-label {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gray-60);
    margin: 0;
  }

  .servicios__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 6rem);
    font-weight: 900;
    line-height: 1.05;
    color: var(--color-black);
    text-wrap: balance;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2em;
  }

  .servicios__title-line {
    display: block;
  }

  /* ── Body: cards + personaje ── */
  .servicios__body {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-8);
    max-width: 960px;
    margin: 0 auto;
    width: 100%;
  }

  .servicios__cards {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* ── Personaje derecha ── */
  .servicios__character {
    width: clamp(160px, 20vw, 280px);
    flex-shrink: 0;
    pointer-events: none;
    position: sticky;
    top: calc(var(--nav-height) + var(--space-6));
    align-self: flex-start;
  }

  .servicios__character img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Cards ── */
  .servicios__card {
    border-top: 1px solid var(--color-gray-10);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .servicios__card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }

  .servicios__card-name {
    font-family: var(--font-body);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-black);
    font-weight: 700;
    margin: 0;
  }

  .servicios__card-price {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gray-60);
    white-space: nowrap;
  }

  .servicios__card-for {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-gray-75);
    line-height: 1.6;
    margin: 0;
  }

  .servicios__card-includes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .servicios__card-includes li {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-gray-60);
    line-height: 1.6;
  }

  .servicios__card-includes li::before {
    content: "— ";
  }

  .servicios__card-deliverables {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .servicios__deliverables-label {
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gray-60);
  }

  .servicios__deliverables-text {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-gray-75);
    line-height: 1.6;
    margin: 0;
  }

  .servicios__card-cta {
    display: inline-flex;
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-black);
    font-weight: 700;
    text-decoration: none;
    border: 1px solid var(--color-black);
    border-radius: var(--radius-sm);
    padding: 0.375rem 0.75rem;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .servicios__card-cta:hover {
    color: var(--color-blue);
    border-color: var(--color-blue);
  }

  .servicios__card-cta:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .servicios {
      padding: var(--space-4);
      padding-top: var(--space-4);
      gap: var(--space-6);
    }

    .servicios__body {
      flex-direction: column;
    }

    .servicios__character {
      position: static;
      width: clamp(120px, 40vw, 200px);
      align-self: flex-end;
    }
  }
</style>
